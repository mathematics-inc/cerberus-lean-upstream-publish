(*
  | StructDef of list (Symbol.identifier * ctype)
  | UnionDef of list (Symbol.identifier * ctype)
*)

type integer_type_match =
  | MatchedItySigned of integerType
  | MatchedItyUnsigned of integerType
  | NotMatchedIty

let match_integer_ctype (Ctype _ ty_) =
  match ty_ with
    | Basic (Integer ity) ->
        if AilTypesAux.is_signed_ity ity then
          MatchedItySigned ity
        else
          MatchedItyUnsigned ity
    | _ ->
        NotMatchedIty
  end

(* === Totality declares (arc 3 sweep, 2026-08-18): Lean-target only.
   are_compatible_aux / are_compatible_params_aux / are_compatible_params
   form a mutual family bounded by the finite set of tag pairs in the
   two tagDefs maps and structural descent between map lookups. The
   path-local assumed-compatible list prevents repeated tag-pair hops.
   Fuel all three (all-or-none for mutual blocks); the bool witnesses
   only discharge typing, with fuelExhausted preserving the runtime
   panic until the sufficiency measures are supplied. === *)
declare {lean} fuel val are_compatible_aux = `fuelExhausted false`
declare {lean} fuel val are_compatible_params_aux = `fuelExhausted (fun _ => false)`
declare {lean} fuel val are_compatible_params = `fuelExhausted false`
(* Fuel MEASURES (are-compatible-assumed-set slice, 2026-09-10): hypothesis-free
   bounds on the block's call depth, computed by the fuel-free wrappers —
   lean_frontend/CerbCtypeMeasure.lean (the qualified-helper seam form; proofs in
   Ctype_aux_lemMeasureProofs.lean). Each member's bound covers the WHOLE mutual
   block's depth from that entry (one shared counter). The wrappers start at the
   ENTRY FUELS auxFuel/paramsAuxFuel/paramsFuel, which are at or above those
   bounds but avoid materializing every pair of tag occurrences of the two
   tables; the proofs show the worker is stable at any fuel at or above the
   bound, so results are unchanged. *)
declare {lean} fuel_measure val are_compatible_aux = `CerbCtypeMeasure.auxFuel p p0 p1`
declare {lean} fuel_measure val are_compatible_params_aux = `CerbCtypeMeasure.paramsAuxFuel env1 lemTail`
declare {lean} fuel_measure val are_compatible_params = `CerbCtypeMeasure.paramsFuel env1 params1 params2`
