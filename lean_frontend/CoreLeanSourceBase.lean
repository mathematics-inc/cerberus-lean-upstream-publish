import Driver
import CerberusFresh
import Std.Data.HashMap

/-! Rendering Core values as Lean source that elaborates back to the same
value. This module holds the layout machinery and the printers for library
types; `CoreLeanSourceGen` (generated by `scripts/gen_core_lean_source.lean`)
adds one printer per Core inductive type.

A printer builds a `Doc` tree (one node per constructor application) that
`render` lays out: a term that fits the line width stays on one line;
otherwise its arguments go on indented lines, and a long last argument
continues after `<|` at the same indentation, so sequences of Core
expressions read top to bottom instead of nesting ever deeper.

Two forms are rendered:
* the readable form, for the exported modules: constructors as `.Ctor`
  (resolved from the expected type), symbols and locations through the
  helpers of the helpers module, and frequently used C types as named
  definitions `Ty.<name>`;
* the canonical form, for the value digest: fully qualified constructors,
  no helpers, on one line. -/

namespace CoreLeanSource

inductive Doc where
  | text (s : String)
  /-- An application; head `""` is a plain sequence of its parts. -/
  | app (head : String) (args : Array Doc)
  | list (items : Array Doc)
  | tuple (items : Array Doc)
  deriving Inhabited

structure Builder where
  acc : Array Doc := #[]
  /-- Location policy: a position's file name is mapped by `keepFile`; when
  it returns `none` for any position of a location, the location is
  rendered as `CerbLocation.Loc.unknown`. -/
  keepFile : String → Option String := some
  /-- The canonical (digest) form instead of the readable one. -/
  canonical : Bool := false
  /-- The program's translation-unit digest: its identifiers print as `c!`. -/
  tuDigest : String := ""
  /-- Kept source files: path ↦ the Lean name of its `Src` constant. -/
  fileNames : Std.HashMap String String := {}
  /-- Procedure symbols (`digest/number`) ↦ the definition holding them. -/
  procRefs : Std.HashMap String String := {}
  /-- C-type naming: a counting pass, then the names chosen from it. -/
  counting : Bool := false
  ctypeCount : Std.HashMap String Nat := {}
  /-- The name each counted type would get (`ctypeName?`). -/
  ctypeCand : Std.HashMap String String := {}
  ctypeNames : Std.HashMap String String := {}
  ctypeEmitted : Std.HashSet String := {}
  /-- Named C types, `(name, body)`, each after the names it uses. -/
  typeDefs : Array (String × Doc) := #[]

/-- A printer's effect: append documents to `acc`. -/
abbrev Out := StateM Builder Unit

/-- A printer for values of `α`, with the Lean source of the type `α`. -/
structure P (α : Type) where
  ty : String
  pr : α → Out

instance {α : Type} : Inhabited (P α) := ⟨⟨"", fun _ => pure ()⟩⟩

def push (d : Doc) : Out := modify fun b => { b with acc := b.acc.push d }

def emit (s : String) : Out := push (.text s)

/-- Run `o` on its own and return what it appended. -/
def capture (o : Out) : StateM Builder Doc := do
  let saved := (← get).acc
  modify fun b => { b with acc := #[] }
  o
  let r := (← get).acc
  modify fun b => { b with acc := saved }
  return if h : r.size = 1 then r[0] else .app "" r

/-! ## Layout -/

def width : Nat := 100

/-- The shortest line budget, however deep the indentation. -/
def minLine : Nat := 72

/-- The one-line text of `d` appended to `out` (parenthesised when `paren`
and an application with arguments), or `none` once longer than `limit`. -/
partial def flatAux (d : Doc) (paren : Bool) (out : String) (limit : Nat) : Option String := do
  if out.utf8ByteSize > limit then none
  match d with
  | .text s => some (out ++ s)
  | .app "" args => args.foldlM (fun o a => flatAux a false o limit) out
  | .app h args =>
    if args.isEmpty then return out ++ h
    let mut o := if paren then out ++ "(" ++ h else out ++ h
    for a in args do
      o ← flatAux a true (o ++ " ") limit
    if paren then o := o ++ ")"
    if o.utf8ByteSize > limit then none
    return o
  | .list items => do
    let mut o := out ++ "["
    let mut first := true
    for x in items do
      unless first do o := o ++ ", "
      first := false
      o ← flatAux x false o limit
    if o.utf8ByteSize > limit then none
    return o ++ "]"
  | .tuple items => do
    let mut o := out ++ "("
    let mut first := true
    for x in items do
      unless first do o := o ++ ", "
      first := false
      o ← flatAux x false o limit
    if o.utf8ByteSize > limit then none
    return o ++ ")"

def flat? (d : Doc) (paren : Bool) (limit : Nat) : Option String :=
  match flatAux d paren "" limit with
  | some s => if s.utf8ByteSize ≤ limit then some s else none
  | none => none

def flatAll (d : Doc) : String := (flatAux d false "" (1 <<< 62)).getD ""

def spaces (n : Nat) : String := "".pushn ' ' n

/-- The output and its current column. -/
structure Sink where
  text : String := ""
  col : Nat := 0

def Sink.out (k : Sink) (s : String) : Sink :=
  match (s.splitOn "\n").reverse with
  | [_] | [] => { text := k.text ++ s, col := k.col + s.length }
  | last :: _ => { text := k.text ++ s, col := last.length }

/-- Lay out `d` at the current column; continuation lines are indented to
`ind`. A long last argument follows `<|`: on the same line when its own
head fits there (so chains such as `.Pexpr [] () <| .PEval <| …` share a
line), otherwise on the next line at `ind`. -/
partial def render (d : Doc) (paren : Bool) (ind : Nat) : StateM Sink Unit := do
  let out (s : String) : StateM Sink Unit := modify (·.out s)
  let col := (← get).col
  -- deep terms still get a useful line: at least `minLine` characters
  let budget := max (width - min width col) minLine
  if let some s := flat? d paren budget then out s; return
  match d with
  | .text s => out s
  | .app "" args => for a in args do render a false ind
  | .app h args =>
    let opn := if paren then "(" else ""
    -- continuation lines step from the enclosing line, not the paren column
    -- (inside `(`/`[` Lean imposes no column constraint)
    let ind' := ind
    let last := args.back!
    let init := args.pop
    if (flat? last true budget).isNone then
      -- `h a₁ … aₙ₋₁ <|`, then the last argument
      match flat? (.app h init) false (budget - opn.length - 3) with
      | some hl => out (opn ++ hl ++ " <|")
      | none =>
        out (opn ++ h)
        for a in init do
          out ("\n" ++ spaces (ind' + 2))
          render a true (ind' + 2)
        out " <|"
      let room := width - min width ((← get).col + 1)
      -- join only a head that itself continues with `<|`
      let joins := match last with
        | .app h' args' => !args'.isEmpty && h' != "" &&
            (flat? (.app h' args'.pop) false (room - 3)).isSome &&
            (flat? args'.back! true budget).isNone
        | _ => false
      if joins then out " " else out ("\n" ++ spaces ind')
      render last false ind'
    else
      out (opn ++ h)
      for a in args do
        out ("\n" ++ spaces (ind' + 2))
        render a true (ind' + 2)
    if paren then out ")"
  | .list items =>
    out "["
    let ind' := ind + 1
    for h : i in [:items.size] do
      if i > 0 then out (",\n" ++ spaces ind')
      render items[i] false ind'
    out "]"
  | .tuple items =>
    out "("
    let ind' := ind + 1
    for h : i in [:items.size] do
      if i > 0 then out (",\n" ++ spaces ind')
      render items[i] false ind'
    out ")"

/-- `d` laid out from column `ind`. -/
def layout (d : Doc) (ind : Nat) : String := ((render d false ind).run { col := ind }).2.text

/-! ## Constructors and library types -/

def hexDigit (n : Nat) : Char := "0123456789abcdef".toList[n % 16]!

/-- A Lean string literal denoting exactly `s`; characters outside printable
ASCII are escaped, so the output is ASCII. -/
def stringLiteral (s : String) : String := Id.run do
  let mut acc := "\""
  for c in s.toList do
    let n := c.toNat
    if c == '"' then acc := acc ++ "\\\""
    else if c == '\\' then acc := acc ++ "\\\\"
    else if c == '\n' then acc := acc ++ "\\n"
    else if c == '\t' then acc := acc ++ "\\t"
    else if n ≥ 0x20 && n < 0x7f then acc := acc.push c
    else if n < 0x100 then acc := (acc ++ "\\x").push (hexDigit (n / 16)) |>.push (hexDigit n)
    else acc := acc ++ "\\u{" ++ String.mk (Nat.toDigits 16 n) ++ "}"
  return acc.push '"'

/-- A constructor application being assembled. -/
structure Ctor where
  name : String
  ty : String
  args : Array Out

def app (name ty : String) : Ctor := ⟨name, ty, #[]⟩

def Ctor.arg (c : Ctor) (a : Out) : Ctor := { c with args := c.args.push a }

/-- The readable spelling of a constructor: `.Ctor`, resolved by Lean from
the expected type (every constructor is printed where its type is known). -/
def ctorName (canonical : Bool) (n : String) : String :=
  if canonical then n else
  match n.splitOn "." with
  | [x] => "." ++ x
  | parts => "." ++ parts.getLast!

def Ctor.done (c : Ctor) : Out := do
  let name := ctorName (← get).canonical c.name
  if c.args.isEmpty then emit name else
  let mut ds := #[]
  for a in c.args do ds := ds.push (← capture a)
  push (.app name ds)

def srcNat : P Nat := ⟨"Nat", fun n => emit (toString n)⟩

def srcInt : P Int := ⟨"Int", fun i =>
  emit (if i ≥ 0 then toString i else "(" ++ toString i ++ ")")⟩

def srcString : P String := ⟨"String", fun s => emit (stringLiteral s)⟩

def srcBool : P Bool := ⟨"Bool", fun b => do
  let c := (← get).canonical
  emit (if b then (if c then "true" else ".true") else (if c then "false" else ".false"))⟩

def srcChar : P Char := ⟨"Char", fun c => emit s!"(Char.ofNat {c.toNat})"⟩

def srcUInt8 : P UInt8 := ⟨"UInt8", fun n => emit s!"({n.toNat} : UInt8)"⟩

def srcUInt32 : P UInt32 := ⟨"UInt32", fun n => emit s!"({n.toNat} : UInt32)"⟩

def srcFloat : P Float := ⟨"Float", fun f => emit s!"(Float.ofBits {f.toBits.toNat})"⟩

def srcUnit : P Unit := ⟨"Unit", fun _ => emit "()"⟩

/-- Lists longer than this are split into `List.append` chunks, bounding the
size of each list literal the elaborator sees. -/
def listChunk : Nat := 64

partial def listDoc (items : Array Doc) : Doc :=
  if items.size ≤ listChunk then .list items
  else .app "List.append" #[.list (items.extract 0 listChunk), listDoc (items.extract listChunk items.size)]

def srcList {α : Type} (p : P α) : P (List α) :=
  ⟨"(List " ++ p.ty ++ ")", fun xs => do
    let mut ds := #[]
    for x in xs do ds := ds.push (← capture (p.pr x))
    push (listDoc ds)⟩

def srcArray {α : Type} (p : P α) : P (Array α) :=
  ⟨"(Array " ++ p.ty ++ ")", fun xs => do
    let d ← capture ((srcList p).pr xs.toList)
    push (.app "List.toArray" #[d])⟩

def srcOption {α : Type} (p : P α) : P (Option α) :=
  let ty := "(Option " ++ p.ty ++ ")"
  ⟨ty, fun | none => app "Option.none" ty |>.done
           | some x => app "Option.some" ty |>.arg (p.pr x) |>.done⟩

def srcProd {α β : Type} (p : P α) (q : P β) : P (α × β) :=
  ⟨"(" ++ p.ty ++ " × " ++ q.ty ++ ")", fun (a, b) => do
    let da ← capture (p.pr a)
    let db ← capture (q.pr b)
    push (.tuple #[da, db])⟩

partial def srcPmap {α β : Type} (pk : P α) (pv : P β) : P (Pmap α β) :=
  let ty := "(Pmap " ++ pk.ty ++ " " ++ pv.ty ++ ")"
  ⟨ty, fun
    | .Empty => app "Pmap.Empty" ty |>.done
    | .Node l k v r h => app "Pmap.Node" ty
        |>.arg ((srcPmap pk pv).pr l) |>.arg (pk.pr k) |>.arg (pv.pr v)
        |>.arg ((srcPmap pk pv).pr r) |>.arg (srcNat.pr h) |>.done⟩

/-- The keys of a `Pmap`, in order. -/
def pmapKeys {α β : Type} : Pmap α β → List α → List α
  | .Empty, ks => ks
  | .Node l k _ r _, ks => pmapKeys l (k :: pmapKeys r ks)

/-- An `Fmap` carries its comparator, a function. It is rendered as `cand`
(whose source is `candSrc`), the key type's `MapKeyType` comparator, after
checking that `cand` agrees with the map's own comparator on every key and
every pair of adjacent keys, and that the tree is ordered. The tree is
rendered node by node, so lookups and traversals see the same structure. -/
def srcFmapWith {α β : Type} (cand : α → α → LemOrdering) (candSrc : String)
    (pk : P α) (pv : P β) (tree : P (Pmap α β)) : P (Fmap α β) :=
  let ty := "(Fmap " ++ pk.ty ++ " " ++ pv.ty ++ ")"
  ⟨ty, fun
    | .empty => app "Fmap.empty" ty |>.done
    | .mk cmp m =>
      let ks := pmapKeys m []
      let pairs := ks.zip ks.tail
      let agree := ks.all (fun k => cmp k k == .EQ && cand k k == .EQ)
        && pairs.all (fun (a, b) => cmp a b == .LT && cand a b == .LT
                                    && cmp b a == .GT && cand b a == .GT)
      if !agree then panic! s!"Fmap comparator differs from {candSrc}" else
      app "Fmap.mk" ty |>.arg (emit candSrc) |>.arg (tree.pr m) |>.done⟩

def srcFmap {α β : Type} (cand : α → α → LemOrdering) (candSrc : String)
    (pk : P α) (pv : P β) : P (Fmap α β) :=
  srcFmapWith cand candSrc pk pv (srcPmap pk pv)

/-! ## Locations -/

/-- Positions of a location, with the file names they mention. -/
def locFiles : CerbLocation.Loc → List String
  | .unknown | .other _ => []
  | .point p => [p.file]
  | .region a b c => [a.file, b.file] ++ cursorFiles c
  | .regions ps c => ps.foldr (fun (a, b) acc => a.file :: b.file :: acc) [] ++ cursorFiles c
where cursorFiles : CerbLocation.Cursor → List String
  | .noCursor => []
  | .pointCursor p => [p.file]
  | .regionCursor a b => [a.file, b.file]

/-- The file of a location's first position, before any rewriting. -/
def locFile? : CerbLocation.Loc → Option String
  | .point p | .region p _ _ => some p.file
  | .regions ((p, _) :: _) _ => some p.file
  | _ => none

/-- The first line of a location. -/
def locLine : CerbLocation.Loc → Nat
  | .point p | .region p _ _ => p.line
  | .regions ((p, _) :: _) _ => p.line
  | _ => 0

/-- Locations, under the builder's `keepFile` policy. `other` locations
carry free text, not a position, and are rendered as unknown. Readable
form: `pt! F l c`, `rg! F l c l' c'` (a region within one file, no
cursor), `rgc! F l c l' c' lc cc` (with a point cursor) and
`rgr! F l c l' c' l₁ c₁ l₂ c₂` (with a region cursor), where `F` is the
file's `Src` constant. -/
def srcLoc : P CerbLocation.Loc := ⟨"CerbLocation.Loc", fun loc => do
  let b ← get
  let keep := b.keepFile
  let canon := b.canonical
  let unknown := if canon then "CerbLocation.Loc.unknown" else ".unknown"
  if (locFiles loc).any (keep · |>.isNone) then emit unknown else
  let file (f : String) : Doc :=
    let f := (keep f).getD f
    match (if canon then none else b.fileNames[f]?) with
    | some n => .text n
    | none => .text (stringLiteral f)
  let n (k : Nat) : Doc := .text (toString k)
  let pos (p : CerbLocation.Pos) : Doc := .app "CerbLocation.Pos.mk" #[file p.file, n p.line, n p.col]
  let cursor : CerbLocation.Cursor → Doc
    | .noCursor => .text "CerbLocation.Cursor.noCursor"
    | .pointCursor p => .app "CerbLocation.Cursor.pointCursor" #[pos p]
    | .regionCursor a c => .app "CerbLocation.Cursor.regionCursor" #[pos a, pos c]
  match loc with
  | .unknown | .other _ => emit unknown
  | .point p => push (if canon then .app "CerbLocation.Loc.point" #[pos p]
                      else .app "pt!" #[file p.file, n p.line, n p.col])
  | .region a c cur =>
    if canon || a.file != c.file then push (.app "CerbLocation.Loc.region" #[pos a, pos c, cursor cur])
    else match cur with
      | .noCursor => push (.app "rg!" #[file a.file, n a.line, n a.col, n c.line, n c.col])
      | .pointCursor p =>
        if p.file == a.file then
          push (.app "rgc!" #[file a.file, n a.line, n a.col, n c.line, n c.col, n p.line, n p.col])
        else push (.app "CerbLocation.Loc.region" #[pos a, pos c, cursor cur])
      | .regionCursor p q =>
        if p.file == a.file && q.file == a.file then
          push (.app "rgr!" #[file a.file, n a.line, n a.col, n c.line, n c.col,
                              n p.line, n p.col, n q.line, n q.col])
        else push (.app "CerbLocation.Loc.region" #[pos a, pos c, cursor cur])
  | .regions ps cur =>
    push (.app "CerbLocation.Loc.regions"
      #[.list (ps.toArray.map fun (a, c) => .tuple #[pos a, pos c]), cursor cur])⟩

/-! ## Symbols and C types -/

/-- Symbols. Readable form: `c! "name" n` for an identifier of the program,
`rt! "name" n` for one of the Cerberus runtime (empty digest), `addr! "x" n`
for the address of the program's object `x`, `a! n` for an unnamed one
(Core's `a_n`); other symbols in full, with
`Src.digest` for the program's digest. -/
def srcSymWith (desc : P symbol_description) : P sym := ⟨"sym", fun
  | .Symbol dg n d => do
    let b ← get
    let num := Doc.text (toString n)
    let str (s : String) := Doc.text (stringLiteral s)
    if b.canonical then
      push (.app "sym.Symbol" #[str dg, num, ← capture (desc.pr d)])
    else match d with
      | .SD_Id x =>
        if dg == b.tuDigest then push (.app "c!" #[str x, num])
        else if dg == "" then push (.app "rt!" #[str x, num])
        else push (.app "sym.Symbol" #[str dg, num, ← capture (desc.pr d)])
      | .SD_ObjectAddress x =>
        if dg == b.tuDigest then push (.app "addr!" #[str x, num])
        else push (.app "sym.Symbol" #[str dg, num, ← capture (desc.pr d)])
      | .SD_None =>
        if dg == b.tuDigest then push (.app "a!" #[num])
        else push (.app "sym.Symbol" #[str dg, num, ← capture (desc.pr d)])
      | _ =>
        let dgd := if dg == b.tuDigest then Doc.text "Src.digest" else str dg
        push (.app "sym.Symbol" #[dgd, num, ← capture (desc.pr d)])⟩

def symName? : sym → Option String
  | .Symbol _ _ (.SD_Id x) => some x
  | _ => none

def integerBaseName : integerBaseType → String
  | .Ichar => "char" | .Short => "short" | .Int_ => "int" | .Long => "long"
  | .LongLong => "long_long" | .IntN_t k => s!"int{k}_t"
  | .Int_leastN_t k => s!"int_least{k}_t" | .Int_fastN_t k => s!"int_fast{k}_t"
  | .Intmax_t => "intmax_t" | .Intptr_t => "intptr_t"

def integerTypeName : integerType → Option String
  | .Char0 => some "char" | .Bool0 => some "bool"
  | .Signed .Ichar => some "signed_char"
  | .Signed t => some (integerBaseName t)
  | .Unsigned t => some ("unsigned_" ++ integerBaseName t)
  | .Enum0 s => (symName? s).map ("enum_" ++ ·)
  | .Wchar_t => some "wchar_t" | .Wint_t => some "wint_t" | .Size_t => some "size_t"
  | .Ptrdiff_t => some "ptrdiff_t" | .Ptraddr_t => some "ptraddr_t"

def qualPrefix (q : qualifiers) : String :=
  let .mk c r v := q
  (if c then "const_" else "") ++ (if r then "restrict_" else "") ++ (if v then "volatile_" else "")

/-- A Lean name for a C type, spelt after its C declaration: `int`,
`unsigned_char`, `ptr_const_unsigned_char` (pointer to const unsigned char),
`array_32_unsigned_char`, `struct_noise_handshake`. -/
partial def ctypeName? : ctype → Option String
  | .Ctype [] t => match t with
    | .Void0 => some "void"
    | .Basic (.Integer it) => integerTypeName it
    | .Array0 e (some k) => (ctypeName? e).map (s!"array_{k}_" ++ ·)
    | .Array0 e none => (ctypeName? e).map ("array_" ++ ·)
    | .Pointer q e => (ctypeName? e).map (fun s => "ptr_" ++ qualPrefix q ++ s)
    | .Atomic e => (ctypeName? e).map ("atomic_" ++ ·)
    | .Struct s => (symName? s).map ("struct_" ++ ·)
    | .Union0 s => (symName? s).map ("union_" ++ ·)
    | _ => none
  | _ => none

/-- The C spelling of an integer type. -/
def integerTypeC : integerType → String
  | .Char0 => "char" | .Bool0 => "_Bool"
  | .Signed .Ichar => "signed char"
  | .Signed t => (integerBaseName t).replace "long_long" "long long"
  | .Unsigned t => "unsigned " ++ (integerBaseName t).replace "long_long" "long long"
  | .Enum0 s => "enum " ++ (symName? s).getD "<anonymous>"
  | .Wchar_t => "wchar_t" | .Wint_t => "wint_t" | .Size_t => "size_t"
  | .Ptrdiff_t => "ptrdiff_t" | .Ptraddr_t => "ptraddr_t"

/-- A C type in a declaration of `name` (C declarator syntax), for the
prototypes in documentation comments. Qualifiers are those Core keeps on
the pointed-to type. -/
partial def cDecl (t : ctype) (name : String) : String :=
  let .Ctype _ t := t
  let sp (s : String) := if name.isEmpty then s else s ++ " " ++ name
  match t with
  | .Void0 => sp "void"
  | .Basic (.Integer it) => sp (integerTypeC it)
  | .Basic (.Floating _) => sp "double"
  | .Byte => sp "unsigned char"
  | .Struct s => sp ("struct " ++ (symName? s).getD "<anonymous>")
  | .Union0 s => sp ("union " ++ (symName? s).getD "<anonymous>")
  | .Atomic e => cDecl e ("_Atomic " ++ name)
  | .Pointer q e =>
    let .mk c r v := q
    let quals := (if c then "const " else "") ++ (if v then "volatile " else "")
    let inner := "*" ++ (if r then "restrict " else "") ++ name
    match e with
    | .Ctype _ (.Array0 _ _) | .Ctype _ (.Function _ _ _) | .Ctype _ (.FunctionNoParams _) =>
      cDecl e ("(" ++ inner ++ ")")
    | _ => quals ++ cDecl e inner
  | .Array0 e k => cDecl e (name ++ "[" ++ (k.map toString).getD "" ++ "]")
  | .Function (_, r) ps variadic =>
    let args := ps.map (fun (_, t, _) => cDecl t "")
    let args := if variadic then args ++ ["..."] else args
    cDecl r (name ++ "(" ++ (if args.isEmpty then "void" else ", ".intercalate args) ++ ")")
  | .FunctionNoParams (_, r) => cDecl r (name ++ "()")

/-- C types. A type that occurs often enough is printed as `Ty.<name>`, a
definition of the types module. -/
def srcCtypeWith (inner : P ctype) : P ctype := ⟨inner.ty, fun c => do
  let b ← get
  if b.canonical || (ctypeName? c).isNone then inner.pr c else
  if b.counting then
    let d ← capture (inner.pr c)
    let key := flatAll d
    modify fun b => { b with ctypeCount := b.ctypeCount.insert key (b.ctypeCount.getD key 0 + 1),
                             ctypeCand := b.ctypeCand.insert key ((ctypeName? c).getD "") }
    push d
  else
    -- the key is the type's text without type names, as in the counting pass
    let names := b.ctypeNames
    modify fun b => { b with ctypeNames := {} }
    let key := flatAll (← capture (inner.pr c))
    modify fun b => { b with ctypeNames := names }
    match names[key]? with
    | none => inner.pr c
    | some name =>
      unless (← get).ctypeEmitted.contains name do
        let d ← capture (inner.pr c)
        modify fun b => { b with typeDefs := b.typeDefs.push (name, d),
                                 ctypeEmitted := b.ctypeEmitted.insert name }
      emit ("Ty." ++ name)⟩

/-! ## Procedure maps -/

def symKey : sym → String
  | .Symbol dg n _ => dg ++ "/" ++ toString n

/-- A procedure map. In the readable form each procedure is a reference to
its definition (`procRefs`); in the canonical form each procedure is the MD5
of its canonical text. -/
partial def srcFunMapPmap {β : Type} (pk : P sym) (pv : P β) : P (Pmap sym β) :=
  let ty := "(Pmap " ++ pk.ty ++ " " ++ pv.ty ++ ")"
  ⟨ty, fun
    | .Empty => app "Pmap.Empty" ty |>.done
    | .Node l k v r h => app "Pmap.Node" ty
        |>.arg ((srcFunMapPmap pk pv).pr l) |>.arg (pk.pr k)
        |>.arg (do
            let b ← get
            if b.canonical then
              let d ← capture (pv.pr v)
              emit (stringLiteral (CerberusFresh.md5Hex (flatAll d)))
            else match b.procRefs[symKey k]? with
              | some name => emit name
              | none => pv.pr v)
        |>.arg ((srcFunMapPmap pk pv).pr r) |>.arg (srcNat.pr h) |>.done⟩

def srcFunMap {β : Type} (pk : P sym) (pv : P β) : P (Fmap sym β) :=
  srcFmapWith (@Lem_Map.mapKeyCompare sym _) "(@Lem_Map.mapKeyCompare (sym) _)" pk pv
    (srcFunMapPmap pk pv)

/-! ## Symbol collection (for pruning) -/

/-- Collected symbols, in visiting order (with repetitions). -/
abbrev Syms := StateM (Array sym) Unit

def colNone {α : Type} (_ : α) : Syms := pure ()
def colSym (s : sym) : Syms := modify (·.push s)
def colList {α : Type} (c : α → Syms) (xs : List α) : Syms := xs.forM c
def colOption {α : Type} (c : α → Syms) : Option α → Syms
  | none => pure ()
  | some x => c x
def colProd {α β : Type} (c : α → Syms) (d : β → Syms) : α × β → Syms
  | (a, b) => c a *> d b
def colPmap {α β : Type} (c : α → Syms) (d : β → Syms) : Pmap α β → Syms
  | .Empty => pure ()
  | .Node l k v r _ => colPmap c d l *> c k *> d v *> colPmap c d r
def colFmap {α β : Type} (c : α → Syms) (d : β → Syms) (m : Fmap α β) : Syms :=
  colPmap c d m.rep

end CoreLeanSource
